# Goal: Start searching for ArUco markers
int32 required_markers  # Number of markers to find
float32 max_search_time  # Maximum search time in seconds
---
# Result: Summary of found markers
int32[] found_marker_ids      # List of all detected marker IDs
float32 total_search_time     # How long the search took
---
# Feedback: Progress during search
int32 waypoint_index          # Current waypoint number
int32 total_waypoints         # Total waypoints to visit
int32[] currently_found_ids   # Markers found so far